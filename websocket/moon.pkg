import {
  "moonbitlang/async",
  "moonbitlang/async/http",
  "moonbitlang/async/websocket" @async_websocket,
  "moonbitlang/core/debug",
  "moonbitlang/core/encoding/utf8",
}

import {
  "moonbitlang/async/socket",
  "moonbitlang/async/os_error",
} for "wbtest"

// The cleanup defers are semantically wrapped in @async.protect_from_cancel;
// current lint does not recognize the public re-export as a shield.

warnings = "+missing_doc+unnecessary_annotation-98"

// Native-only (depends on moonbitlang/async/{http,websocket}).

options(
  targets: { "runtime_wbtest.mbt": [ "native" ] },
)
